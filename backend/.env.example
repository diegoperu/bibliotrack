# ── Database ──────────────────────────────────────────────────────────────────
# Path assoluto consigliato in produzione
DATABASE_URL=sqlite:///./bibliotrack.db

# ── JWT ───────────────────────────────────────────────────────────────────────
# OBBLIGATORIO: genera con `openssl rand -hex 32` (minimo 32 caratteri)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── File storage ──────────────────────────────────────────────────────────────
# Directory dove vengono salvate le copertine scaricate
COVERS_DIR=./static/covers

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origini permesse, separate da virgola. "*" = consenti tutte.
# Dev: http://localhost:5173,http://localhost:3000
# Produzione con dominio: https://tuodominio.it
# Docker (same-origin): lasciar vuoto o "*"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

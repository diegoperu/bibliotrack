# Normalize line endings
* text=auto

# Shell scripts always LF (required for Linux/Docker execution)
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

# Config/data files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.service text eol=lf

# Python
*.py text eol=lf

# Web
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Markdown
*.md text eol=lf
